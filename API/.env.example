POLICY_DB_NAME=routerease_policy
POLICY_DB_USER=routerease_policy
POLICY_DB_PASSWORD=change-me-with-a-random-secret
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-with-a-random-secret
KEYCLOAK_ADMIN_USER=replace-with-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-with-a-random-secret
# Optional but recommended: use a different value from the Keycloak bootstrap
# password for Traefik dashboard Basic Auth.
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=replace-with-a-different-long-random-secret
# Issuer is the URL published in Keycloak discovery; audience is the API client ID.
OIDC_ISSUER=https://routerease.example/realms/routerease
OIDC_AUDIENCE=routerease-api
# Optional; required only when launching the cloudflare Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=
